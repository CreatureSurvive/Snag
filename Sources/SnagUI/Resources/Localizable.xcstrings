    "Passwords, tokens and areas marked private are removed before anything is saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passwörter, Tokens und als privat markierte Bereiche werden entfernt, bevor etwas gesichert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las contraseñas, los tokens y las zonas marcadas como privadas se eliminan antes de guardar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les mots de passe, jetons et zones marquées comme privées sont supprimés avant tout enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "パスワード、トークン、プライベートとしてマークされた領域は、保存前に削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senhas, tokens e áreas marcadas como privadas são removidos antes de qualquer coisa ser salva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密码、令牌和标记为私密的区域会在保存前移除。"
          }
        }
      }
    },
    "Photos you add aren't redacted automatically; use Mark Up → Hide to cover anything private.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hinzugefügte Fotos werden nicht automatisch geschwärzt. Verwende „Markieren“ → „Verbergen“, um Privates abzudecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las fotos que añadas no se ocultan automáticamente; usa Marcar → Ocultar para tapar lo que sea privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les photos ajoutées ne sont pas masquées automatiquement ; utilisez Annoter → Masquer pour couvrir les éléments privés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "追加した写真は自動では伏せられません。「マークアップ」→「隠す」でプライベートな部分を覆ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As fotos adicionadas não são ocultadas automaticamente; use Marcação → Ocultar para cobrir o que for privado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "添加的照片不会自动遮盖；请使用“标记”→“隐藏”遮住私密内容。"
          }
        }
      }
    },
    "Problems you report appear here, with replies from the developer.": {
