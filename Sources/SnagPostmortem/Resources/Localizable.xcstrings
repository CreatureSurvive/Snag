  "strings": {
    "%@ quit unexpectedly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wurde unerwartet beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ se ha cerrado inesperadamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ a quitté inopinément"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@が予期せず終了しました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ foi encerrado inesperadamente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”意外退出"
          }
        }
      }
    },
    "%@ stopped responding": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ hat nicht mehr reagiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ha dejado de responder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ne répondait plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@が応答しなくなりました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ parou de responder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”停止响应"
          }
        }
      }
    },
    "A report with technical details helps fix it. No personal information is included.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Bericht mit technischen Details hilft bei der Behebung. Persönliche Daten sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un informe con detalles técnicos ayuda a solucionarlo. No incluye información personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un rapport avec des détails techniques aide à corriger le problème. Aucune information personnelle n’est incluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "技術的な詳細を含むレポートが修正に役立ちます。個人情報は含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um relatório com detalhes técnicos ajuda a corrigir o problema. Nenhuma informação pessoal é incluída."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "包含技术细节的报告有助于修复问题。不包含任何个人信息。"
          }
        }
      }
    },
